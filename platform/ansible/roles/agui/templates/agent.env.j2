# Managed by spe-ansible (role: agui). Only the agent container receives this file.
SPE_AGENT_API_KEY={{ spe_agent_api_key }}
SANDBOX_API_KEY={{ spe_terminal_api_key }}
{{ 'ANTHROPIC_API_KEY' if spe_agent_model_provider == 'anthropic' else 'OPENAI_API_KEY' }}={{ spe_agent_llm_key | trim }}
{% if spe_harden_airlock | bool %}
# L5 airlock (spe_harden_airlock): the agent redacts classes of sensitive data from its answer.
SPE_AIRLOCK=1
SPE_STUDY_ID_PREFIX={{ spe_study_id_prefix }}
{% endif %}
