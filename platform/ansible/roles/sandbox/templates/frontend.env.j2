# Managed by spe-ansible (role: sandbox). Read by docker compose (through the
# docker-compose.yml link to platform/instance/compose.yml) and by spe-apply.
# No secrets here: they are in the env files next to this one.
SPE_REPO_DIR={{ spe_repo_dir }}
SPE_FRONTENDS={{ spe_frontends | join(',') }}
COMPOSE_PROFILES={{ ((['openwebui'] if 'openwebui' in spe_frontends else [])
                     + (['agui', 'ui-dev' if spe_agui_ui_dev | bool else 'ui'] if 'agui' in spe_frontends else [])) | join(',') }}
SPE_TERMINAL_IMAGE={{ spe_frontend_terminal_image }}
SPE_WEBUI_IMAGE={{ spe_frontend_webui_image }}
SPE_AGENT_IMAGE={{ spe_agui_agent_image }}
SPE_CHAT_UI_IMAGE={{ spe_agui_ui_image }}
SPE_WEBUI_PORT={{ spe_webui_local_port }}
SPE_AGUI_UI_PORT={{ spe_agui_ui_port }}
SPE_AGUI_AGENT_PORT={{ spe_agui_agent_port }}
SPE_WEBUI_MODEL_ID={{ spe_webui_model_id }}
SPE_WEBUI_AUTH={{ 'true' if spe_webui_auth else 'false' }}
SPE_AGENT_RELOAD={{ '1' if spe_agent_reload | bool else '0' }}
{% if spe_compose_overlays %}
# Compose overlays a ladder level adds (platform/instance/compose.<name>.yml); spe-apply passes each with -f.
SPE_COMPOSE_OVERLAYS={{ spe_compose_overlays | join(',') }}
{% endif %}
{% if spe_eval_sink | bool %}
SPE_EVAL_SINK_HOST={{ spe_eval_sink_host }}
{% endif %}
{% if spe_harden_egress | bool %}
SPE_SANDBOX_SUBNET={{ spe_sandbox_subnet }}
SPE_SANDBOX_IP={{ spe_sandbox_ip }}
SPE_SANDBOX_DNS={{ spe_sandbox_dns }}
{% endif %}
