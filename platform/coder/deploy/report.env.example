# /etc/sperange/report.env (mode 0640, owner root, group sperange-report)
CODER_URL=http://127.0.0.1:7080
REPORTS_DIR=/data-share/reports
HITS_DIR=/data-share/canary-hits
RUNS_DIR=/data-share/runs
LISTEN=127.0.0.1:7090
# Optional: threat scores on the archived chats' user turns (platform/report/README.md). An
# OpenAI-compatible endpoint that serves the embedding model, and its key.
#THREAT_EMBEDDINGS_URL=https://denbi-llm-api-internal.bihealth.org/v1
#THREAT_EMBEDDINGS_KEY=sk-...
#THREAT_EMBEDDING_MODEL=vllm/BAAI/bge-m3
