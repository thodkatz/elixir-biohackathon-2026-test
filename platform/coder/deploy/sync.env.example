# /etc/sperange/sync.env (mode 0600, owner ubuntu)
SPE_REPO_DIR=/home/ubuntu/sperange   # repo checkout; the template is platform/coder/template, Ansible platform/ansible
SPE_BRANCH=main
SPE_TEMPLATE_NAME=spe-testbed
SPE_SITE_DIR=/srv/sperange-site   # the Caddyfile's root; readable by the caddy user (mkdir, chown ubuntu)
SPE_AGENT_URL=http://PORTAL-PRIVATE-IP:7080
CODER_URL=http://127.0.0.1:7080
CODER_SESSION_TOKEN=...   # coder tokens create --name sync --lifetime 8760h
# Optional: the spe-experiments template name (platform/coder/experiments-template)
#SPE_EXPERIMENTS_TEMPLATE_NAME=spe-experiments
# Optional: templates from branches template/<name> and experiment/<name> (default prefixes
# spe and spe-x, worktrees next to the checkout)
#SPE_BRANCH_TEMPLATE_PREFIX=spe
#SPE_EXPERIMENT_TEMPLATE_PREFIX=spe-x
#SPE_BRANCH_DIR=/home/ubuntu/sperange-branches
