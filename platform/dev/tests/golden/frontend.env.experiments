# Managed by spe-ansible (role: sandbox). Read by docker compose (through the
# docker-compose.yml link to platform/instance/compose.yml) and by spe-apply.
# No secrets here: they are in the env files next to this one.
SPE_REPO_DIR=/home/ubuntu/sperange
SPE_FRONTENDS=openwebui,agui
COMPOSE_PROFILES=openwebui,agui,ui,evals
SPE_TERMINAL_IMAGE=spe-open-terminal:0.16.1
SPE_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.0
SPE_AGENT_IMAGE=spe-agent:local
SPE_CHAT_UI_IMAGE=spe-chat-ui:local
SPE_WEBUI_PORT=8080
SPE_AGUI_UI_PORT=3000
SPE_AGUI_AGENT_PORT=8100
SPE_WEBUI_MODEL_ID=qwen3.8-27b
SPE_WEBUI_AUTH=false
SPE_AGENT_RELOAD=1
# evals-view (profile evals; docs/specs/2026-11-10-experiments-design/04-viewer.md): the three
# written together, never one without the others, so a build never reaches compose.yml's
# placeholder defaults. SPE_EVALS_DATA_DIR is the same directory spe-eval writes as
# PROMPTFOO_CONFIG_DIR (platform/instance/spe_eval.py's spe_eval_home() / "promptfoo"), derived
# from spe_eval_dir here rather than a second literal path.
SPE_EVALS_PORT=8200
SPE_EVALS_VIEW_IMAGE=spe-evals-view:local
SPE_EVALS_DATA_DIR=/home/ubuntu/spe-eval/promptfoo
