def cmd_new(ns: argparse.Namespace) -> int:
    repo_root = spe_eval.repo_dir()
    written = spe_eval.new_experiment(
        repo_root, ns.name, threat=ns.threat, path=ns.path, injection=ns.injection, from_name=ns.from_name,
    )
    print(f"spe-eval new {ns.name}: wrote")
    for path in written:
        print(f"  {path}")
    print(
        "Fill in every TODO (check_experiment.py names each one); delete a slot this idea does "
        "not need -- for an attack only, delete the mitigation file above, its spe_mitigate_* "
        "switch in group_vars/all.yml, set mitigation: null in the experiment file, and set the "
        "test's own metadata.closed_by: null; for a mitigation only, delete the tests file above "
        f"and remove {ns.name!r} from tests in the experiment file."
    )
    print(f"Add a line for {ns.name} to experiments/README.md once it is ready.")
    print(f"Next: spe-eval test {ns.name}, or python3 check_experiment.py {ns.name}")
