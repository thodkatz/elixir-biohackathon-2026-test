# --- test (07-agent-friendly.md, *Test offline*) ----------------------------------------------

def _pytest_argv() -> list[str]:
    """`uv run --group dev pytest -q`, the way the `spe_eval` Ansible role itself runs these
    tests (it installs `uv` to `/usr/local/bin` and runs `uv sync --group dev` there at creation);
    `python3 -m pytest -q` when `uv` is not on `$PATH` (e.g. a plain development checkout)."""
    uv = shutil.which("uv")
    if uv:
        return [uv, "run", "--group", "dev", "pytest", "-q"]
    return [sys.executable, "-m", "pytest", "-q"]


def _run_pytest(repo_root: Path) -> int:
    promptfoo_dir = repo_root / "platform" / "promptfoo-evals"
    argv = _pytest_argv()
    try:
        result = subprocess.run(argv, cwd=promptfoo_dir, capture_output=True, text=True)
    except OSError as e:
        _print_err(f"could not run {' '.join(argv)}: {e}")
        return 2
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    # Path(argv[0]).name, not argv[0]: argv[0] is shutil.which("uv")'s own full path (e.g.
    # /usr/local/bin/uv), never the bare string "uv", so comparing argv[0] itself would always
    # differ -- this hint would then fire even when uv really ran and really lacked the module,
    # instead of only the no-uv fallback case it is meant for.
    if Path(argv[0]).name != "uv" and "No module named pytest" in result.stderr:
        _print_err(
            "no `uv` on PATH and no pytest module installed here; install pytest "
            "(`uv sync --group dev` in platform/promptfoo-evals) and retry"
        )
        return 2
    if result.returncode not in (0, 1):
        _print_err(f"{' '.join(argv)} exited {result.returncode} (not a pass/fail pytest run)")
        return 2
    return result.returncode


def _experiment_to_check(repo_root: Path) -> str | None:
    """The build's own experiment (`instances/local.yml`'s `spe_experiment`), or `None` to check
    every experiment: this is not a `spe-experiments` build at all (e.g. a plain development
    checkout running `spe-eval test` offline)."""
    try:
        local_vars = spe_eval.load_local_vars(repo_root)
        return spe_eval.default_experiment_name(local_vars)
    except spe_eval.ConfigError:
        return None


def cmd_test(ns: argparse.Namespace) -> int:
    repo_root = spe_eval.repo_dir()
    pytest_rc = _run_pytest(repo_root)
    if pytest_rc == 2:
        return 2

    # `ns.name`, when given, overrides the build's own experiment: the documented path writes a
    # new `<name>` with `spe-eval new` on a `ladder-l0` build, and `test` with no name would
    # otherwise keep checking `ladder-l0`, never the new, still-TODO `<name>`, and exit 0
    # regardless.
    name = ns.name or _experiment_to_check(repo_root)
    check_argv = [sys.executable, str(repo_root / "check_experiment.py")] + ([name] if name else [])
    try:
        check_result = subprocess.run(check_argv, cwd=repo_root, capture_output=True, text=True)
    except OSError as e:
        _print_err(f"could not run {' '.join(check_argv)}: {e}")
        return 2
    sys.stdout.write(check_result.stdout)
    sys.stderr.write(check_result.stderr)
    if check_result.returncode == 2:
        return 2

    return 1 if (pytest_rc != 0 or check_result.returncode != 0) else 0


# --- arm -------------------------------------------------------------------------------------

def cmd_arm(ns: argparse.Namespace) -> int:
    if len(ns.args) == 1:
        name, arm = None, ns.args[0]
    elif len(ns.args) == 2:
        name, arm = ns.args
    else:
        raise spe_eval.ConfigError("usage: spe-eval arm [<name>] baseline|mitigated")
    if arm not in ("baseline", "mitigated"):
        raise spe_eval.ConfigError(f"{arm!r}: expected baseline or mitigated")

    repo_root = spe_eval.repo_dir()
    home = _home()
    local_vars = spe_eval.load_local_vars(repo_root)
    experiment_name = name or spe_eval.default_experiment_name(local_vars)
    experiment = spe_eval.load_experiment(experiment_name, repo_root)
    spe_eval.check_build_matches(experiment, local_vars, repo_root)
    spe_eval.arm_mitigations(experiment, arm)  # validates `arm` against this experiment's own arms

    token = spe_eval.run_id()
    lock = spe_eval.Lock(spe_eval.spe_eval_home(home) / "lock")
    lock.acquire(token)  # raises LockHeld (caught by main()) if another run/arm holds it
    state = _StopState()  # no handler installed: a short apply, nothing persistent to clean up
    try:
        values = spe_eval.arm_vars(experiment, arm, repo_root)
        vars_path = spe_eval.write_json(values, spe_eval.spe_eval_home(home) / "current-arm.json")
        rc = _spe_apply(state, ["all", "-e", f"@{vars_path}"], token=token)
        if rc != 0:
            _print_err(f"spe-apply all failed (exit {rc})")
            return 1
        if not _wait_for_stack(state):
            _print_err("the stack did not answer in time")
            return 1
        print(f"{experiment_name} {arm}: applied, the stack answers")
        return 0
    finally:
        lock.release()


# --- run -------------------------------------------------------------------------------------

_TAKES_OVER_MESSAGE = (
    "spe-eval run: this takes the workspace over -- the chat is not usable while it runs (every "
    "test restores the stack), and anything registered by hand in TRS or WES is reset to the "
    "arm's snapshot before each test.")


def _run_one_arm(state: _StopState, repo_root: Path, home: Path, token: str, model: str, ns: argparse.Namespace,
                  plan: dict) -> str:
    """One arm's apply-then-run.sh, from `plan` (`arm`, `out_dir`, `mitigations`, `values`,
    `suite_path`, all precomputed before any arm started). Returns the final state (`ok`/`gate
    refused`/`failed`/`stopped`); never raises -- an unexpected exception
    here still ends in `failed` (or `stopped`, if one arrived first), so the per-arm `run.json`
    this wraps around always reaches a terminal state."""
    arm, out_dir, mitigations = plan["arm"], plan["out_dir"], plan["mitigations"]
    try:
        vars_path = spe_eval.write_json(plan["values"], spe_eval.spe_eval_home(home) / "current-arm.json")
        apply_rc = _spe_apply(state, ["all", "-e", f"@{vars_path}"], token=token)
        if state.stopped:
            return "stopped"
        if apply_rc != 0:
            return "failed"
        if not _wait_for_stack(state):
            return "stopped" if state.stopped else "failed"

        description = f"{plan['experiment_name']} {token} {arm} [{', '.join(mitigations)}] {model}"
        handoff_dir = spe_eval.spe_eval_home(home) / "handoff"
        progress_path = out_dir / "progress.jsonl"
        run_sh = str(Path(repo_root) / "platform" / "promptfoo-evals" / "run.sh")
        run_env = spe_eval.promptfoo_env(handoff_dir, spe_eval.spe_eval_home(home) / "promptfoo", progress_path)
        argv = [run_sh, str(handoff_dir), str(ns.repeat), "--suite", str(plan["suite_path"]),
                "--reports-dir", str(out_dir), "--description", description]
        run_rc = _run_tracked(state, argv, run_env)
        if state.stopped:
            return "stopped"
        if run_rc == 0:
            return "ok"
        if run_rc == 3:
            return "gate refused"
        return "failed"
    except Exception as exc:  # the arm's run.json still gets a terminal state (Important 2)
        _print_err(f"arm {arm} failed: {exc}")
        return "stopped" if state.stopped else "failed"


def cmd_run(ns: argparse.Namespace) -> int:
    repo_root = spe_eval.repo_dir()
    home = _home()
    local_vars = spe_eval.load_local_vars(repo_root)
    experiment_name = ns.name or spe_eval.default_experiment_name(local_vars)
    experiment = spe_eval.load_experiment(experiment_name, repo_root)
    spe_eval.check_build_matches(experiment, local_vars, repo_root)
    arms = spe_eval.experiment_arms(experiment)

    # The run id is fixed right as the lock is taken (03, *Every run is kept*); SPE_EVAL_RUN_ID
    # lets --detach's child reuse the id its parent already printed (R5).
    token = os.environ.get("SPE_EVAL_RUN_ID") or spe_eval.run_id()
    lock = spe_eval.Lock(spe_eval.spe_eval_home(home) / "lock")
    lock.acquire(token)
    state = _StopState()
    previous_handlers = {sig: signal.signal(sig, state.handler) for sig in (signal.SIGTERM, signal.SIGINT)}
    try:
        out_dirs = {arm: spe_eval.reports_dir(experiment_name, token, arm, home) for arm in arms}
        existing = sorted(str(d) for d in out_dirs.values() if d.exists())
        if existing:
            raise spe_eval.ConfigError("reports directory already exists: " + ", ".join(existing))

        # Every arm's vars and suite config, computed up front: an unknown injection or test id
        # (arm_vars/suite_config) fails here, before any apply touches the stack (Important 2).
        plans = []
        for arm in arms:
            out_dir = out_dirs[arm]
            out_dir.mkdir(parents=True, exist_ok=True)
            plans.append({
                "arm": arm, "out_dir": out_dir, "experiment_name": experiment_name,
                "mitigations": spe_eval.arm_mitigations(experiment, arm),
                "values": spe_eval.arm_vars(experiment, arm, repo_root),
                "suite_path": spe_eval.suite_config(experiment, out_dir, repo_root),
            })

        print(_TAKES_OVER_MESSAGE)
        model_provider = local_vars.get("spe_agent_model_provider") or ""
        model_name = local_vars.get("spe_agent_model") or ""
        model = f"{model_provider}:{model_name}" if model_provider or model_name else "?"
        window_start = spe_eval.iso_now()
        windows_path = spe_eval.spe_eval_home(home) / "windows.jsonl"
        # The opening line, before any arm runs: a receiver hit during a long run is already in a window
        # (end null: open) when the hit watcher reads it, and a run SIGKILLed past here still left one.
        spe_eval.append_jsonl(windows_path, {"run": token, "experiment": experiment_name, "start": window_start,
                                             "end": None})
        any_bad = False
        try:
            for plan in plans:
                if state.stopped:
                    break
                arm, out_dir, mitigations = plan["arm"], plan["out_dir"], plan["mitigations"]
                record = {"experiment": experiment_name, "run": token, "arm": arm, "mitigations": mitigations,
                          "model": model, "repeat": ns.repeat, "started": spe_eval.iso_now(), "state": "running"}
                spe_eval.write_json(record, out_dir / "run.json")
                arm_state = "failed"  # overwritten below; kept if _run_one_arm somehow still raises
                try:
                    arm_state = _run_one_arm(state, repo_root, home, token, model, ns, plan)
                finally:
                    notes_path = out_dir / "gate-notes.json"
                    notes = []
                    if notes_path.is_file():
                        try:
                            notes = json.loads(notes_path.read_text())
                        except ValueError:
                            notes = []
                    record["state"] = arm_state
                    record["ended"] = spe_eval.iso_now()
                    record["gate_notes"] = notes
                    # Merge onto whatever run.sh itself already wrote to this run.json (on success,
                    # `started`/`canaries_sha256`) rather than overwriting it outright, so
                    # matrix.counts/replay keep finding canaries_sha256 here.
                    run_json_path = out_dir / "run.json"
                    on_disk: dict = {}
                    if run_json_path.is_file():
                        try:
                            on_disk = json.loads(run_json_path.read_text())
                        except ValueError:
                            on_disk = {}
                    spe_eval.write_json({**on_disk, **record}, run_json_path)
                if arm_state != "ok":
                    any_bad = True
        finally:
            # Even an exception escaping the loop above (not just its normal end or a SIGTERM
            # break) still appends this run's closing line, so its window gets its end. A SIGKILL
            # -- which no Python code, this finally included, ever runs for -- leaves only the
            # opening line: the window stays open until the next run starts.
            window_end = spe_eval.iso_now()
            spe_eval.append_jsonl(windows_path,
                                   {"run": token, "experiment": experiment_name, "start": window_start,
                                    "end": window_end})
        # Back to the build's own arm: instances/local.yml already holds it, so no -e override is
        # needed. Its own failure is reported but never hides the run's own outcome: the workspace
        # is left changed either way, so it still counts as exit 1.
        return_rc = _spe_apply(state, ["all"], token=token)
        if return_rc != 0:
            _print_err(f"returning to the build's own arm failed (spe-apply all exit {return_rc}); "
                       "the workspace is left in the last arm's state")
            any_bad = True
        print(f"results: ~/spe-eval/reports/{experiment_name}/{token}/ (spe-eval results, or the Evaluations app)")
        return 1 if any_bad else 0
    finally:
        for sig, old in previous_handlers.items():
            signal.signal(sig, old)
        lock.release()


def cmd_run_detached(ns: argparse.Namespace) -> int:
    # The same up-front checks cmd_run makes, so a typo'd experiment or a build mismatch exits 2
    # here, in the caller, rather than only inside a unit nobody is watching. A lock already held
    # is the same LockHeld main() turns into exit 2.
    repo_root = spe_eval.repo_dir()
    home = _home()
    local_vars = spe_eval.load_local_vars(repo_root)
    experiment_name = ns.name or spe_eval.default_experiment_name(local_vars)
    experiment = spe_eval.load_experiment(experiment_name, repo_root)
    spe_eval.check_build_matches(experiment, local_vars, repo_root)
    spe_eval.experiment_arms(experiment)
    lock = spe_eval.Lock(spe_eval.spe_eval_home(home) / "lock")
    holder = lock.holder()
    if holder is not None:
        raise spe_eval.LockHeld(holder)

    print(_TAKES_OVER_MESSAGE)  # the child prints it again to its own (journal) stdout; minor 8
    token = spe_eval.run_id()
    unit = f"spe-eval-{token}"
    argv = ["systemd-run", "--user", f"--unit={unit}", f"--setenv=SPE_EVAL_RUN_ID={token}"]
    for var in ("SPE_REPO_DIR", "SPE_FRONTEND_DIR", "HOME"):
        if os.environ.get(var):
            argv.append(f"--setenv={var}={os.environ[var]}")
    argv += ["--", sys.executable, str(_HERE), "run"]
    if ns.name:
        argv.append(ns.name)
    argv += ["--repeat", str(ns.repeat)]
    result = subprocess.run(argv, env=_user_bus_env(), capture_output=True, text=True)
    if result.returncode != 0:
        _print_err(f"systemd-run failed (exit {result.returncode}): {result.stderr.strip()}")
        return 2

    # Don't return until the child actually holds the lock (or clearly hasn't within a bounded
    # wait), so a `wait` right after this never sees "no run in progress" for a run that is in
    # fact starting (Important 3). SPE_EVAL_DETACH_WAIT_TIMEOUT/_INTERVAL override the defaults,
    # for tests.
    timeout = float(os.environ.get("SPE_EVAL_DETACH_WAIT_TIMEOUT", "10"))
    interval = float(os.environ.get("SPE_EVAL_DETACH_WAIT_INTERVAL", "0.1"))
    deadline = time.monotonic() + timeout
    while lock.holder() != token:
        if time.monotonic() >= deadline:
            _print_err(f"run {token} did not take the lock within {timeout}s; it may have failed to start")
            return 1
        time.sleep(interval)
    print(token)
    return 0


def cmd_run_dispatch(ns: argparse.Namespace) -> int:
    return cmd_run_detached(ns) if ns.detach else cmd_run(ns)


# --- status / wait / runs ---------------------------------------------------------------------

def _status_info(home: Path) -> dict:
    lock = spe_eval.Lock(spe_eval.spe_eval_home(home) / "lock")
    holder = lock.holder()
    info: dict = {"locked": holder is not None, "holder": holder, "run": None, "experiment": None,
                  "arm": None, "state": None, "done": None, "total": None, "last_error": None}
    if holder is not None:
        # Held by `arm` (no report at all) or by `run` before its first run.json exists: leave
        # run/experiment/arm/state null rather than showing some past run's details next to this
        # holder's token. Never fall back to the newest past run while something is actually
        # holding the lock.
        entry = spe_eval.run_entry(home, holder)
    else:
        runs = spe_eval.discover_runs(home)
        entry = runs[0] if runs else None
    if entry is not None:
        info["run"] = entry["run"]
        info["experiment"] = entry["experiment"]
        arms = entry["arms"]
        running = [name for name, record in arms.items() if record.get("state") == "running"]
        # the arm most recently started: "running" if one still is, else the lexicographically
        # last (baseline < mitigated matches run order, 03's arm sequence).
        arm_name = running[0] if running else (sorted(arms)[-1] if arms else None)
        if arm_name:
            record = arms[arm_name]
            info["arm"] = arm_name
            info["state"] = record.get("state")
            repeat = record.get("repeat") or 1
            progress_path = spe_eval.reports_dir(entry["experiment"], entry["run"], arm_name, home) / "progress.jsonl"
            progress = spe_eval.read_progress(progress_path, repeat)
            info["total"] = progress["total"]
            info["done"] = progress["done"]
            info["last_error"] = progress["last_error"]
    return info


def cmd_status(ns: argparse.Namespace) -> int:
    info = _status_info(_home())
    if ns.json:
        print(json.dumps(info))
        return 0
    if not info["locked"] and info["run"] is None:
        print("spe-eval status: no run has happened yet")
        return 0
    print(f"lock: {info['holder']}" if info["locked"] else "lock: free")
    if info["run"]:
        progress = f"{info['done']} of {info['total']}" if info["total"] is not None else f"{info['done']} done"
        print(f"run {info['run']} ({info['experiment']}), arm {info['arm']}: {info['state']}, {progress}")
        if info["last_error"]:
            print(f"last error: {info['last_error']}")
    return 0


def cmd_wait(ns: argparse.Namespace) -> int:
    home = _home()
    lock = spe_eval.Lock(spe_eval.spe_eval_home(home) / "lock")
    token = lock.holder()
    if token is not None:
        deadline = None if ns.timeout is None else time.monotonic() + ns.timeout
        interval = float(os.environ.get("SPE_EVAL_WAIT_INTERVAL", "2"))
        while lock.holder() == token:
            if deadline is not None and time.monotonic() >= deadline:
                _print_err(f"run {token} did not finish within {ns.timeout}s")
                return 1
            time.sleep(interval)
    else:
        # Nothing was running when wait was called: judge the newest kept run instead, rather
        # than exiting 0 unconditionally -- so `run --detach` racing a `wait` that lands after the
        # run already ended still gets that run's real outcome, and one with no run at all still
        # says so.
        runs = spe_eval.discover_runs(home)
        if not runs:
            print("spe-eval wait: no run has happened yet")
            return 0
        token = runs[0]["run"]
    entry = spe_eval.run_entry(home, token)
    if entry is None:
        # No report at all for this token: an `arm` holder (which keeps none by design) or a
        # `run` that crashed before writing its first arm's run.json. Neither is evidence of a
        # failed *run* (minor 7), so this is not exit 1.
        print(f"run {token} ended (no report found; it may have been an `arm`, which keeps none)")
        return 0
    ok = all(record.get("state") == "ok" for record in entry["arms"].values())
    for arm_name, record in sorted(entry["arms"].items()):
        print(f"{arm_name}: {record.get('state')}")
    return 0 if ok else 1


def cmd_runs(ns: argparse.Namespace) -> int:
    entries = spe_eval.discover_runs(_home())
    if ns.json:
        print(json.dumps(entries))
        return 0
    if not entries:
        print("spe-eval runs: none yet")
        return 0
    for entry in entries:
        arms = entry["arms"]
        first = next(iter(arms.values()), {})
        model = first.get("model", "?")
        repeat = first.get("repeat", "?")
        arm_summary = ", ".join(
            f"{name} ({','.join(record.get('mitigations') or []) or 'none'}): {record.get('state')}"
            for name, record in sorted(arms.items()))
        print(f"{entry['run']}  {entry['experiment']}  model={model} repeat={repeat}  {arm_summary}")
    return 0


# --- results (07-agent-friendly.md, *Read*) ----------------------------------------------------

def _entry_for_results(ns: argparse.Namespace, home: Path) -> spe_eval.ConfigError | dict:
    """`run_entry(home, ns.run)`, or the newest of `discover_runs` when `--run` is not given;
    returns a `ConfigError` instance (never raises it) for "no run to read" -- `main()` only maps
    `ConfigError` to exit 2, but this is exit 1 (07: "no run: exit 1"), so `cmd_results` decides
    the exit code itself rather than letting `main()`'s usual mapping apply."""
    if ns.run:
        entry = spe_eval.run_entry(home, ns.run)
        if entry is None:
            return spe_eval.ConfigError(f"no run {ns.run!r} found")
        return entry
    runs = spe_eval.discover_runs(home)
    if not runs:
        return spe_eval.ConfigError("no run has happened yet")
    return runs[0]


def cmd_results(ns: argparse.Namespace) -> int:
    home = _home()
    entry = _entry_for_results(ns, home)
    if isinstance(entry, spe_eval.ConfigError):
        _print_err(str(entry))
        return 1
    # build_results never raises: an arm that is still running, or ended anything but "ok", is
    # reported as unusable rather than crashing; "no arm usable at all" is exit 1 here, the same
    # "no run to read" case as _entry_for_results above.
    results = spe_eval.build_results(entry, home)
    if not results["usable_arms"]:
        _print_err(spe_eval.unusable_run_message(results))
        return 1

    # Computed before any printing: with --json, the reasons join the one JSON document rather
    # than following it as separate text, which would make stdout unparseable.
    reasons = spe_eval.test_reasons(entry, ns.test, home) if ns.test else None
    if ns.json:
        if reasons is not None:
            results = {**results, "reasons": {"test": ns.test, "by_arm": reasons}}
        print(json.dumps(results))
        return 0

    sys.stdout.write(spe_eval.format_results_text(results))
    if reasons is not None:
        if not reasons:
            print(f"no assertion reasons recorded for {ns.test}")
        else:
            print(f"reasons for {ns.test}:")
            for arm in sorted(reasons):
                print(f"  {arm}:")
                for reason in reasons[arm]:
                    print(f"    {reason}")
    return 0


# --- pr-body (05-contribution.md, *The PR*; 07-agent-friendly.md, *Share*) ----------------------

def _check_experiment(repo_root: Path, name: str) -> tuple[int, str]:
    """`check_experiment.py <name>` (never the whole catalogue: `pr-body` is one experiment's own
    contribution), returning its exit code and the text to quote under *Checks*. It is specified
    to finish in under a minute (check_experiment.py's own docstring); a generous 90s timeout
    keeps `pr-body` from hanging an agent if it ever does not."""
    argv = [sys.executable, str(repo_root / "check_experiment.py"), name]
    try:
        result = subprocess.run(argv, cwd=repo_root, capture_output=True, text=True, timeout=90)
    except OSError as e:
        raise spe_eval.ConfigError(f"could not run check_experiment.py: {e}") from None
    except subprocess.TimeoutExpired:
        raise spe_eval.ConfigError("check_experiment.py did not finish within 90s") from None
    output = (result.stdout + result.stderr).strip() or "OK: no problems found"
    return result.returncode, output


def cmd_pr_body(ns: argparse.Namespace) -> int:
    repo_root = spe_eval.repo_dir()
    home = _home()
    if ns.name:
        name = ns.name
    else:
        local_vars = spe_eval.load_local_vars(repo_root)
        name = spe_eval.default_experiment_name(local_vars)
    experiment = spe_eval.load_experiment(name, repo_root)  # ConfigError (exit 2) for a bad name

    if ns.run:
        # An explicitly named run that does not exist (or is another experiment's) is a usage
        # error, not "no run yet" (07: "no run: a Result placeholder" is about there being none
        # at all, never about a --run id that was typed wrong).
        entry = spe_eval.run_entry(home, ns.run)
        if entry is None:
            raise spe_eval.ConfigError(f"no run {ns.run!r} found")
        if entry["experiment"] != name:
            raise spe_eval.ConfigError(f"run {ns.run!r} is experiment {entry['experiment']!r}, not {name!r}")
    else:
        entry = next((e for e in spe_eval.discover_runs(home) if e["experiment"] == name), None)
    results = spe_eval.build_results(entry, home) if entry is not None else None

    checker_rc, checker_output = _check_experiment(repo_root, name)
    if checker_rc == 2:
        _print_err(f"check_experiment.py {name}: {checker_output}")
        return 2

    title, body = spe_eval.pr_body_text(repo_root, name, experiment, results, checker_output)
    print(f"title: {title}")
    print()
    sys.stdout.write(body)
    return 0


# --- argument parsing -------------------------------------------------------------------------

def _repeat_type(value: str) -> int:
    """`--repeat`, checked up front: `run.sh`'s own usage check only runs after a full
    `spe-apply all` and marks the arm `failed`; argparse's own usage error (exit 2) here catches a
    bad value before any of that."""
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid int value: {value!r}") from None
    if n < 1:
        raise argparse.ArgumentTypeError(f"--repeat must be >= 1, not {n}")
    return n


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="spe-eval", description="Measure an experiment on this workspace.",
                                      epilog=COMMAND_TABLE, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command")

    p_new = sub.add_parser("new", help="write every slot of a new experiment's skeleton, with TODOs")
    p_new.add_argument("name")
    p_new.add_argument("--threat", help="a threats/TM-NNN id, existing or new")
    p_new.add_argument("--path", help="a paths/P<n> id, existing or new")
    p_new.add_argument("--injection", metavar="SURFACE", help="plant a new injection on this surface")
    p_new.add_argument("--from", dest="from_name", metavar="EXPERIMENT",
                        help="base this experiment's base mitigations on <EXPERIMENT>'s base plus its own mitigation")
    p_new.set_defaults(handler=cmd_new)

    p_test = sub.add_parser("test", help="offline: the evaluations' unit tests, then check_experiment.py")
    p_test.add_argument("name", nargs="?", help="an experiments/<name>.yml stem; default: the build's own")
    p_test.set_defaults(handler=cmd_test)

    p_arm = sub.add_parser("arm", help="apply one arm and wait for the stack to answer")
    p_arm.add_argument("args", nargs="+", metavar="[<name>] baseline|mitigated")
    p_arm.set_defaults(handler=cmd_arm)

    p_run = sub.add_parser("run", help="measure every arm of an experiment")
    p_run.add_argument("name", nargs="?")
    p_run.add_argument("--repeat", type=_repeat_type, default=1)
    p_run.add_argument("--detach", action="store_true")
    p_run.set_defaults(handler=cmd_run_dispatch)

    p_status = sub.add_parser("status", help="the lock, the run in progress and its test count")
    p_status.add_argument("--json", action="store_true")
    p_status.set_defaults(handler=cmd_status)

    p_wait = sub.add_parser("wait", help="block until the run in progress ends")
    p_wait.add_argument("--timeout", type=float, default=None)
    p_wait.set_defaults(handler=cmd_wait)

    p_runs = sub.add_parser("runs", help="every kept run, newest first")
    p_runs.add_argument("--json", action="store_true")
    p_runs.set_defaults(handler=cmd_runs)

    p_results = sub.add_parser(
        "results", help="the latest run (or the one named): per test and metric, baseline vs. mitigated")
    p_results.add_argument("--run", metavar="ID", help="a run id (spe-eval runs); default: the newest")
    p_results.add_argument("--json", action="store_true")
    p_results.add_argument("--test", metavar="ID", help="also print this test's assertion reasons from agent.json")
    p_results.set_defaults(handler=cmd_results)

    p_pr_body = sub.add_parser(
        "pr-body",
        help="print a PR title and body for <name> from its files and its latest run",
        description="Prints the title on its own first line (\"title: <title>\"), a blank line, then the PR "
                     "body (the template filled in from the experiment's files, its latest run -- or the one "
                     "named by --run -- and check_experiment.py's own output). Split for "
                     "`gh pr create --title <title> --body-file -`, e.g.:\n"
                     "    title=$(spe-eval pr-body <name> | sed -n '1s/^title: //p')\n"
                     "    spe-eval pr-body <name> | tail -n +3 | gh pr create --title \"$title\" --body-file -",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p_pr_body.add_argument("name", nargs="?", help="an experiments/<name>.yml stem; default: the build's own")
    p_pr_body.add_argument("--run", metavar="ID", help="a run id (spe-eval runs); default: <name>'s newest")
    p_pr_body.set_defaults(handler=cmd_pr_body)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    ns = parser.parse_args(argv)
    handler = getattr(ns, "handler", None)
    if handler is None:
        parser.print_help()
        return 2
    try:
        return handler(ns)
    except (spe_eval.ConfigError, ValueError, spe_eval.LockHeld) as e:
        _print_err(str(e))
        return 2


if __name__ == "__main__":
    sys.exit(main())
